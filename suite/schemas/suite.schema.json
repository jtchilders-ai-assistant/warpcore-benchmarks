{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jtchilders-ai-assistant/warpcore-benchmarks/suite/schemas/suite.schema.json",
  "title": "Warpcore v1 Suite Specification",
  "description": "Schema for the suite/warpcore-v1.yaml file. Defines the contract for all experiment-level settings owned by the suite. Lifecycle and execution state enums are owned by result-status.schema.json; the suite YAML must not duplicate them.",
  "type": "object",
  "required": [
    "suite_id",
    "suite_schema_version",
    "statistical_policy",
    "benchmarks",
    "required_harness",
    "empty_response_classification",
    "publication_rules"
  ],
  "additionalProperties": false,
  "properties": {
    "suite_id": {
      "type": "string",
      "const": "warpcore-v1",
      "description": "Canonical suite identifier. Must be exactly 'warpcore-v1'."
    },
    "suite_schema_version": {
      "type": "integer",
      "const": 1,
      "description": "Schema version. Must be exactly 1."
    },
    "statistical_policy": {
      "type": "object",
      "required": [
        "cross_model_comparison",
        "binary_test",
        "cross_model_requires_identical_item_sets",
        "non_significant_means",
        "interval_method",
        "reweighted_requires_uncertainty"
      ],
      "additionalProperties": false,
      "properties": {
        "cross_model_comparison": {
          "type": "string"
        },
        "binary_test": {
          "type": "string"
        },
        "cross_model_requires_identical_item_sets": {
          "type": "boolean"
        },
        "non_significant_means": {
          "type": "string"
        },
        "interval_method": {
          "type": "string"
        },
        "reweighted_requires_uncertainty": {
          "type": "boolean"
        }
      }
    },
    "benchmarks": {
      "type": "object",
      "required": ["gsm8k", "ifeval", "gpqa_diamond", "swebench", "throughput"],
      "additionalProperties": false,
      "minProperties": 5,
      "properties": {
        "gsm8k": {
          "$ref": "#/$defs/quality_benchmark"
        },
        "ifeval": {
          "$ref": "#/$defs/quality_benchmark"
        },
        "gpqa_diamond": {
          "$ref": "#/$defs/quality_benchmark"
        },
        "swebench": {
          "$ref": "#/$defs/swebench_benchmark"
        },
        "throughput": {
          "$ref": "#/$defs/throughput_benchmark"
        }
      }
    },
    "required_harness": {
      "type": "object",
      "required": [
        "lm_eval_version",
        "lm_eval_revision",
        "mini_swe_agent_version",
        "swebench_version"
      ],
      "additionalProperties": false,
      "properties": {
        "lm_eval_version": {
          "type": "string",
          "description": "Exact lm-eval package version pin. Must be a semver like X.Y.Z, not a range.",
          "pattern": "^\\d+\\.\\d+\\.\\d+$"
        },
        "lm_eval_revision": {
          "type": "string",
          "description": "Exact lm-eval source git commit SHA (40 lowercase hex).",
          "pattern": "^[0-9a-f]{40}$"
        },
        "mini_swe_agent_version": {
          "type": "string",
          "description": "Exact mini-swe-agent package version pin. Must be a semver like X.Y.Z.",
          "pattern": "^\\d+\\.\\d+\\.\\d+$"
        },
        "swebench_version": {
          "type": "string",
          "description": "Exact swebench grading harness package version pin. Must be a semver like X.Y.Z.",
          "pattern": "^\\d+\\.\\d+\\.\\d+$"
        }
      }
    },
    "empty_response_classification": {
      "type": "object",
      "required": [
        "finish_length_empty",
        "finish_stop_reasoning_populated",
        "finish_stop_nothing_anywhere"
      ],
      "additionalProperties": false,
      "properties": {
        "finish_length_empty": {
          "type": "string"
        },
        "finish_stop_reasoning_populated": {
          "type": "string"
        },
        "finish_stop_nothing_anywhere": {
          "type": "string"
        }
      }
    },
    "publication_rules": {
      "type": "object",
      "required": [
        "only_lifecycle_current",
        "no_cross_task_overall_rank",
        "missing_cells",
        "no_imputation",
        "denominator_must_be_published"
      ],
      "additionalProperties": false,
      "properties": {
        "only_lifecycle_current": {
          "type": "boolean"
        },
        "no_cross_task_overall_rank": {
          "type": "boolean"
        },
        "missing_cells": {
          "type": "string"
        },
        "no_imputation": {
          "type": "boolean"
        },
        "denominator_must_be_published": {
          "type": "boolean"
        }
      }
    }
  },
  "$defs": {
    "sha256_hex64": {
      "type": "string",
      "description": "Exact 64-character lowercase hexadecimal SHA-256 hash.",
      "pattern": "^[0-9a-f]{64}$"
    },
    "git_commit_sha40": {
      "type": "string",
      "description": "Exact 40-character lowercase hexadecimal git commit SHA.",
      "pattern": "^[0-9a-f]{40}$"
    },
    "sampling": {
      "type": "object",
      "required": [
        "temperature",
        "do_sample"
      ],
      "additionalProperties": false,
      "properties": {
        "temperature": {
          "type": "number"
        },
        "do_sample": {
          "type": "boolean"
        }
      }
    },
    "throughput_sampling": {
      "type": "object",
      "required": [
        "temperature"
      ],
      "additionalProperties": false,
      "properties": {
        "temperature": {
          "type": "number"
        }
      }
    },
    "dataset_ref": {
      "type": "object",
      "required": [
        "path",
        "split",
        "revision"
      ],
      "additionalProperties": false,
      "properties": {
        "path": {
          "type": "string"
        },
        "name": {
          "type": [
            "string",
            "null"
          ]
        },
        "split": {
          "type": "string"
        },
        "revision": {
          "type": "string",
          "description": "Immutable HuggingFace dataset commit SHA (40 lowercase hex).",
          "pattern": "^[0-9a-f]{40}$"
        }
      }
    },
    "swebench_dataset_ref": {
      "type": "object",
      "required": [
        "path",
        "revision"
      ],
      "additionalProperties": false,
      "properties": {
        "path": {
          "type": "string",
          "const": "princeton-nlp/SWE-bench_Verified",
          "description": "SWE-bench Verified dataset on HuggingFace. Must be exactly 'princeton-nlp/SWE-bench_Verified'."
        },
        "revision": {
          "type": "string",
          "description": "Immutable HuggingFace dataset commit SHA (40 lowercase hex).",
          "pattern": "^[0-9a-f]{40}$"
        }
      }
    },
    "retry_policy": {
      "type": "object",
      "required": [
        "max_retries"
      ],
      "additionalProperties": false,
      "properties": {
        "max_retries": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "timeout_policy": {
      "type": "object",
      "required": [
        "use_arithmetic"
      ],
      "additionalProperties": false,
      "properties": {
        "use_arithmetic": {
          "type": "boolean"
        },
        "safety_factor": {
          "type": "number",
          "minimum": 1
        },
        "command_timeout_s": {
          "type": "integer",
          "minimum": 1
        },
        "llm_request_timeout_s": {
          "type": "integer",
          "minimum": 1
        },
        "pull_timeout_s": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "quality_benchmark": {
      "type": "object",
      "required": [
        "description",
        "task_file",
        "task_sha256",
        "dataset",
        "generation_ceiling",
        "sampling",
        "num_fewshot",
        "canonical_headline",
        "expected_item_count",
        "required_evidence",
        "retry_policy",
        "timeout_policy"
      ],
      "additionalProperties": false,
      "properties": {
        "description": {
          "type": "string"
        },
        "task_file": {
          "type": "string",
          "minLength": 1
        },
        "task_sha256": {
          "$ref": "#/$defs/sha256_hex64"
        },
        "utils_file": {
          "type": "string"
        },
        "utils_sha256": {
          "$ref": "#/$defs/sha256_hex64"
        },
        "dataset": {
          "$ref": "#/$defs/dataset_ref"
        },
        "generation_ceiling": {
          "type": "integer",
          "minimum": 1
        },
        "sampling": {
          "$ref": "#/$defs/sampling"
        },
        "num_fewshot": {
          "type": "integer",
          "minimum": 0
        },
        "canonical_headline": {
          "type": "string"
        },
        "expected_item_count": {
          "type": "integer",
          "minimum": 1
        },
        "required_evidence": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "retry_policy": {
          "$ref": "#/$defs/retry_policy"
        },
        "timeout_policy": {
          "$ref": "#/$defs/timeout_policy"
        }
      }
    },
    "swebench_benchmark": {
      "type": "object",
      "required": [
        "description",
        "dataset",
        "instance_set_file",
        "instances_sha256",
        "scaffold_file",
        "scaffold_sha256",
        "expected_item_count",
        "canonical_headline",
        "disposition_categories",
        "cross_model_inference",
        "client_host",
        "required_evidence",
        "retry_policy",
        "timeout_policy"
      ],
      "additionalProperties": false,
      "properties": {
        "description": {
          "type": "string"
        },
        "dataset": {
          "$ref": "#/$defs/swebench_dataset_ref"
        },
        "instance_set_file": {
          "type": "string"
        },
        "instances_sha256": {
          "$ref": "#/$defs/sha256_hex64"
        },
        "scaffold_file": {
          "type": "string"
        },
        "scaffold_sha256": {
          "$ref": "#/$defs/sha256_hex64"
        },
        "expected_item_count": {
          "type": "integer",
          "minimum": 1
        },
        "canonical_headline": {
          "type": "string"
        },
        "disposition_categories": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "cross_model_inference": {
          "type": "string"
        },
        "client_host": {
          "type": "string"
        },
        "required_evidence": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "retry_policy": {
          "$ref": "#/$defs/retry_policy"
        },
        "timeout_policy": {
          "$ref": "#/$defs/timeout_policy"
        }
      }
    },
    "throughput_benchmark": {
      "type": "object",
      "required": [
        "description",
        "host",
        "endpoint",
        "workload",
        "sampling",
        "termination",
        "concurrency_policy",
        "report",
        "retry_policy",
        "timeout_policy"
      ],
      "additionalProperties": false,
      "properties": {
        "description": {
          "type": "string"
        },
        "host": {
          "type": "string"
        },
        "endpoint": {
          "type": "string"
        },
        "workload": {
          "type": "object",
          "required": [
            "input_tokens",
            "output_tokens"
          ],
          "additionalProperties": false,
          "properties": {
            "input_tokens": {
              "type": "integer",
              "minimum": 1
            },
            "output_tokens": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "sampling": {
          "$ref": "#/$defs/throughput_sampling"
        },
        "termination": {
          "type": "string"
        },
        "concurrency_policy": {
          "type": "string"
        },
        "report": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "retry_policy": {
          "$ref": "#/$defs/retry_policy"
        },
        "timeout_policy": {
          "$ref": "#/$defs/timeout_policy"
        }
      }
    }
  }
}
